# =============================================================================
# CADDY CONFIGURATION - Mesh Router Template
# =============================================================================
# Container routing is handled via Docker labels (caddy-docker-proxy)
# This file defines global config and reusable snippets only
# =============================================================================

{
    log {
        output stdout
        format console
        # The catch-all watcher in entrypoint.sh reads the admin API every few
        # seconds, and Caddy logs every admin request at INFO. Unfiltered, that
        # was most of an unrotated container log growing ~50 MB/day. The
        # watcher prints its own line whenever it changes anything.
        exclude admin.api
        # The access log goes only to the `usage` logger (entrypoint, USAGE).
        exclude http.log.access
    }

    # Let's Encrypt email for certificate registration (used for sslip.io domains)
    email {$PCS_EMAIL}

    # PROXY v2 from the gateways (client address on passthrough) and their
    # X-Forwarded-For on terminated requests: a `servers :443` block that
    # mesh-router-caddy's entrypoint writes from the backend's gateway list
    # (PROXY PROTOCOL in its entrypoint.sh). A glob, so an image that does not
    # write the file yet only logs a warning: caddy-docker-proxy drops a block
    # whose plain import is missing.
    import /data/mesh-proxy*.caddy

    # The `usage` logger: access log to mesh-router-agent while MESH_USAGE_REPORT=on
    # (entrypoint, USAGE). A glob, so "off" (no file) is only a warning.
    import /data/mesh-usage*.caddy
}

# Custom CA TLS for gateway-routed and ip.<zone> (IP_ZONE) domains
# Gateway trusts this CA, so no LE needed for these routes
(gateway_tls) {
    # Restore original host when request comes through CF worker
    # The CF worker may rewrite Host to an IP name for routing, but preserves
    # the original nsl.sh domain in X-Original-Host. Restoring it ensures
    # apps generate correct redirect URLs and cookie domains.
    @has_original_host header X-Original-Host *
    request_header @has_original_host Host {http.request.header.X-Original-Host}
    tls /certs/cert.pem /certs/key.pem
}

# =============================================================================
# ROOT DOMAIN ROUTING - Configurable default service
# =============================================================================

# Root domain via gateway (custom CA)
{$DOMAIN} {
    import gateway_tls
    reverse_proxy {$DEFAULT_SERVICE_HOST}:{$DEFAULT_SERVICE_PORT}
}

# Root domain via sslip.io (Let's Encrypt)
{$PUBLIC_IP_DASH}.sslip.io {
    reverse_proxy {$DEFAULT_SERVICE_HOST}:{$DEFAULT_SERVICE_PORT}
}
